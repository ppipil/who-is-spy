# DeepSeek OpenAI-compatible API
DEEPSEEK_API_KEY=sk-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional pricing override for provider aliases or private gateways.
# Set all three together, in USD per 1M tokens. Official v4 model names
# use the built-in DeepSeek peak/off-peak rate card when these are unset.
# DEEPSEEK_INPUT_CACHE_HIT_USD_PER_MILLION=
# DEEPSEEK_INPUT_CACHE_MISS_USD_PER_MILLION=
# DEEPSEEK_OUTPUT_USD_PER_MILLION=

# Optional
PORT=8787
ENABLE_ADMIN_CONSOLE=1
